<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_light"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:id="@+id/w_next_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="下一节课"
        android:textColor="#0F5C4C"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_next_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#14241F"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_next_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#43534B"
        android:textSize="14sp" />

    <Chronometer
        android:id="@+id/w_next_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:countDown="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#0F5C4C"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/w_next_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#0F5C4C"
        android:textSize="13sp" />

    <!-- RemoteViews 不允许裸 <View>，占位/分隔一律用空 TextView -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/w_next_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#7A857F"
        android:textSize="12sp" />
</LinearLayout>
